{
  "version": 2,
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/src/index.html" },
    { "source": "/css/(.*)", "destination": "/src/css/$1" },
    { "source": "/js/(.*)", "destination": "/src/js/$1" },
    { "source": "/api/questions", "destination": "/data/questions.json" }
  ]
}
